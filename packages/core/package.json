{
  "name": "pyscript-solid",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ugnmura/pyscript-solid.git"
  },
  "description": "Use PyScript together with Solid.js.",
  "author": "Eugene Matsumura",
  "keywords": [
    "solid",
    "pyscript",
    "python",
    "web",
    "wrapper"
  ],
  "license": "MIT",
  "scripts": {
    "release": "semantic-release -e semantic-release-monorepo",
    "build": "vite build && vite build --mode ssr && tsc -p tsconfig.build.json",
    "dev": "vite build --watch --emptyOutDir false",
    "test": "vitest run --coverage",
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsc --noEmit",
    "test:package": "node --test test/package.test.mjs",
    "dev:types": "tsc -p tsconfig.build.json --watch",
    "test:watch": "vitest",
    "dev:test": "vite --config test/browser/vite.config.mts"
  },
  "devDependencies": {
    "@pyscript-solid/config": "workspace:*",
    "@types/node": "^24.13.4",
    "jsdom": "^30.0.1",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "@solidjs/testing-library": "^0.8.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "solid-js": "^1.9.15"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/pyscript-solid.cjs",
  "module": "./dist/pyscript-solid.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/pyscript-solid.mjs",
        "require": "./dist/pyscript-solid.cjs"
      },
      "node": {
        "import": "./dist/server/index.mjs",
        "require": "./dist/server/index.js"
      },
      "import": "./dist/pyscript-solid.mjs",
      "require": "./dist/pyscript-solid.cjs"
    }
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}
