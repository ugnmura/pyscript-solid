{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "release": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["GITHUB_TOKEN", "NPM_TOKEN"]
    },
    "test:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev:types": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
