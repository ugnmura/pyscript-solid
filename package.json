{
  "name": "pyscript-solid-workspace",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:types",
    "release": "turbo run release && semantic-release",
    "test": "turbo run test test:package",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "lint": "oxlint --deny-warnings .",
    "test:e2e": "bun run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run test:e2e && bun run docs:test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:test": "bun run docs:build && playwright test --config playwright.docs.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.4",
    "husky": "^9.1.7",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.10.0",
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
